
# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

xcodeproj = './Runner.xcodeproj'
workspace = './Runner.xcworkspace'

default_platform(:ios)

platform :ios do
  
  before_all do
    ENV['FASTLANE_APP_IDENTIFIER'] = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    asc_issuer_id = ENV['APP_STORE_CONNECT_ISSUER_ID']
    if asc_issuer_id && !asc_issuer_id.strip.empty?
      key_id = ENV.fetch('APP_STORE_CONNECT_KEY_ID', 'R989J5VADS')
      key_path = ENV.fetch('APP_STORE_CONNECT_KEY_FILEPATH', '../khanhuitse05_AuthKey_R989J5VADS.p8')
      resolved_key_path = File.expand_path(key_path, __dir__)

      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: asc_issuer_id.strip,
        key_filepath: resolved_key_path,
        in_house: false
      )
    else
      File.write('/tmp/spaceship_itc_service_key.txt', 'e0b80c3bf78523bfe80974d320935bfa30add02e1bff88ec2166c6bd5a706c42')
    end
  end

  desc "Setup and Build for AppStore"
  private_lane :build do
    # Compile Dart and refresh ios/Flutter/Generated.xcconfig before archiving.
    # Skipping this leaves a stale CONFIGURATION_BUILD_DIR and archive fails with:
    # ld: framework 'Pods_Runner' not found
    sh("cd .. && flutter build ios --target lib/main.dart --release --no-codesign")
    build_app(
      workspace: workspace,
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.pingak9.scoreboard" => "scoreboard_appstore",  # update your app bundle id & you provisioning name
        }
      }
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "Runner.ipa"
    )
  end

  desc "Retry upload TestFlight"
  lane :upload do
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "Runner.ipa"
    )
  end

end
